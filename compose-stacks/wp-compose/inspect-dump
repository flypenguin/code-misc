#!/usr/bin/env bash
# Reads the dump and writes .envrc for docker-compose.yml, see README.md.
set -eu
cd "$(dirname "$0")"

die() {
  echo "inspect-dump: $*" >&2
  exit 1
}

# data/dump.sql* comes from DB_ARCHIVE and wins over a hand-placed ./dump.sql*
found=()
for dir in data .; do
  for f in $dir/dump.sql $dir/dump.sql.gz $dir/dump.sql.xz $dir/dump.sql.zst; do
    if [ -f "$f" ]; then found+=("${f#./}"); fi
  done
  [ ${#found[@]} -eq 0 ] || break
done
[ ${#found[@]} -gt 0 ] || die "no dump present: put dump.sql (or .sql.gz, .sql.xz, .sql.zst) into $PWD, or run 'make up DB_ARCHIVE=path/to/backup'"
[ ${#found[@]} -eq 1 ] || die "several dumps present (${found[*]}): keep exactly one"
dump=${found[0]}

case $dump in
  *.gz) unpack="gzip -dc" ;;
  *.xz) unpack="xz -dc" ;;
  *.zst) unpack="zstd -dc" ;;
  *) unpack="cat" ;;
esac
command -v "${unpack%% *}" >/dev/null || die "'${unpack%% *}' not installed, needed to read $dump"

# grep -m1 closes the pipe early; the resulting SIGPIPE is harmless, hence no pipefail
first() { $unpack "$dump" | grep -m1 -oE "$1" || true; }

table=$(first 'CREATE TABLE `[^`]*options`')
[ -n "$table" ] || die "could not determine table prefix: no 'CREATE TABLE \`...options\`' in $dump"
prefix=${table#CREATE TABLE \`}
prefix=${prefix%options\`}
[ -n "$(first "CREATE TABLE \`${prefix}posts\`")" ] ||
  die "found table ${prefix}options but no ${prefix}posts: is $dump a WordPress dump?"

siteurl=$(first "'siteurl', *'[^']*'" | sed -E "s/.*'([^']*)'$/\1/")
[ -n "$siteurl" ] || die "could not determine site url: no 'siteurl' row in ${prefix}options"

# a dump made with --databases imports into its own database, not into MYSQL_DATABASE
db_name=$(first '^USE `[^`]+`' | sed -E 's/USE `(.*)`/\1/')
db_name=${db_name:-wp}

# MariaDB cannot import MySQL 8 collations
db_image=mariadb:11
[ -z "$(first 'utf8mb4_0900_[a-z_]+')" ] || db_image=mysql:8.0

cat >.envrc <<EOF
# Generated by ./inspect-dump from $dump. Do not edit, run "make up [WP_ARCHIVE=...] [DB_ARCHIVE=...]".
export WP_ARCHIVE='${WP_ARCHIVE:-}'
export DB_ARCHIVE='${DB_ARCHIVE:-}'
export WP_DUMP_FILE='$dump'
export WP_DUMP_NAME='${dump##*/}'
export WP_DB_NAME='$db_name'
export WP_TABLE_PREFIX='$prefix'
export WP_SITE_URL='$siteurl'
export WP_DB_IMAGE='$db_image'
EOF
echo "inspect-dump: $dump -> database '$db_name', prefix '$prefix', site $siteurl, $db_image"
