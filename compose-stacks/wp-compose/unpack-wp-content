#!/usr/bin/env bash
# Usage: unpack-wp-content ARCHIVE
# Puts the wp-content directory found in ARCHIVE (tar.*, zip, or a directory) into data/wp-content.
set -eu
cd "$(dirname "$0")"

die() {
  echo "unpack-wp-content: $*" >&2
  exit 1
}

src=${1:-}
[ -n "$src" ] || die "data/wp-content/ missing: run 'make up WP_ARCHIVE=path/to/wp-content-backup.tar.gz'"
[ -e "$src" ] || die "archive '$src' not present"

tmp=data/.unpack
rm -rf "$tmp"
mkdir -p "$tmp"
trap 'rm -rf "$tmp"' EXIT
echo "unpack-wp-content: unpacking $src ..."
case $src in
  *.zip) unzip -q "$src" -d "$tmp" ;;
  *) if [ -d "$src" ]; then cp -a "$src" "$tmp/"; else tar -xf "$src" -C "$tmp"; fi ;;
esac

# the shallowest wp-content dir; else the archive root, if it holds wp-content's children itself
dir=$(find "$tmp" -type d -name wp-content | awk '{ print gsub("/", "/"), $0 }' | sort -n | head -1 | cut -d' ' -f2-)
if [ -z "$dir" ] && [ -d "$tmp/themes" ]; then dir=$tmp; fi
[ -n "$dir" ] || die "no wp-content directory in '$src'"

mv "$dir" data/wp-content
echo "unpack-wp-content: data/wp-content/ ready"
